{
  "name": "shop-hisaab",
  "private": true,
  "type": "module",
  "description": "Shared daily sales book for a small shop (PWA + Firebase).",
  "scripts": {
    "test": "node --test tests/calc.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore,auth --project demo-shop \"node --test tests/rules.test.mjs\"",
    "serve": "firebase emulators:start --only firestore,auth,hosting --project demo-shop",
    "deploy": "firebase deploy --only hosting,firestore"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "10.12.2",
    "firebase-tools": "^13.0.0"
  }
}
