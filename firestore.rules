rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function shopData(code) { return get(/databases/$(database)/documents/shops/$(code)).data; }
    function isMember(code) { return signedIn() && request.auth.uid in shopData(code).memberUids; }
    function isNum(v) { return v is int || v is float; }

    // A shop's document id IS its 8-character join code. Knowing the code is
    // what lets a phone see the shop and join it, so the code is never listed.
    match /shops/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow delete: if false;

      allow create: if signedIn()
        && code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.name is string;

      allow update: if signedIn() && (
        // A new phone joining with the code: may only add itself, max 5 phones.
        (
          !(request.auth.uid in resource.data.memberUids)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberNames'])
          && request.resource.data.memberUids.toSet() == resource.data.memberUids.toSet().union([request.auth.uid].toSet())
          && request.resource.data.memberUids.size() <= 5
          && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid])
        )
        ||
        // Existing members manage the shop (settings, items, removing a lost phone).
        (
          request.auth.uid in resource.data.memberUids
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.size() <= 5
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.memberUids.toSet().difference(resource.data.memberUids.toSet()).size() == 0
        )
      );

      // Bills are never deleted, only marked cancelled, so nothing is lost.
      match /bills/{billId} {
        allow read: if isMember(code);
        allow create: if isMember(code)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.date is string
          && isNum(request.resource.data.total)
          && request.resource.data.total >= 0;
        allow update: if isMember(code)
          && request.resource.data.createdBy == resource.data.createdBy
          && isNum(request.resource.data.total);
        allow delete: if false;
      }

      match /udhaarPayments/{id} {
        allow read: if isMember(code);
        allow create: if isMember(code)
          && request.resource.data.createdBy == request.auth.uid
          && isNum(request.resource.data.amount)
          && request.resource.data.amount > 0;
        allow update: if isMember(code) && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if false;
      }

      match /days/{date} {
        allow read, write: if isMember(code);
        allow delete: if false;
      }
    }
  }
}
